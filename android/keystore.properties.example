# Copy this file to android/keystore.properties. Never commit the copy or the .jks key.
# Use a new upload key dedicated to com.argeha.potuzhnodrop, then back it up in a password manager.
storeFile=play-upload.jks
storePassword=replace-with-a-long-unique-password
keyAlias=potuzhno-drop-upload
keyPassword=replace-with-a-long-unique-password
