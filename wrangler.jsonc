{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "potuzhnodrop",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "vars": {
    "GOOGLE_OAUTH_CLIENT_ID": "432870073159-el2cimceph3fev73b6h62fe81l607f5h.apps.googleusercontent.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "POTUZHNO_STATE",
        "class_name": "PotuzhnoState"
      },
      {
        "name": "POTUZHNO_RATE_LIMIT",
        "class_name": "RateLimiter"
      },
      {
        "name": "POTUZHNO_ADMIN",
        "class_name": "PotuzhnoAdmin"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PotuzhnoState"]
    },
    {
      "tag": "v2-rate-limiter",
      "new_sqlite_classes": ["RateLimiter"]
    },
    {
      "tag": "v3-admin-panel",
      "new_sqlite_classes": ["PotuzhnoAdmin"]
    }
  ]
}
